# From the Developer Portal: Bot -> Token, and General Information -> Application ID.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional. With a server id here, `npm run register` puts the commands in that
# server at once instead of everywhere (which Discord takes up to an hour to show).
DISCORD_GUILD_ID=

# The server's time zones, separated by commas. Members pick one as their clock,
# and every reminder shows its time in each. The first one is used until they pick.
TIMEZONE=Europe/Lisbon,America/New_York

# Optional. Roles every member gets when they join, by name or id, separated by
# commas, like Member. Members without a storage also get No Personal Storage.
JOIN_ROLES=

# Where the database lives, relative to this folder.
DB_PATH=data/personal-storage.db
